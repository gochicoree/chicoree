# Production (docker-compose.prod.yml). scripts/deploy.sh writes this file on
# the server with fresh secrets; edit values there afterwards if needed.
DOMAIN=oci.example.com
ACME_EMAIL=you@example.com
# Uncomment while testing to avoid Let's Encrypt production rate limits:
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_PASSWORD=change-me
AUTH_SECRET=change-me
WEBHOOK_SECRET=change-me
JOBS_API_TOKEN=

# Image layers: a directory on a big disk (e.g. a mounted share); unset = docker volume.
#REGISTRY_DATA_DIR=/mnt/unraid/chicoree/registry

# Vulnerability scanning: SCANNER=off|clair|trivy (empty = clair when CLAIR_URL
# is set, else off). COMPOSE_PROFILES=clair runs the bundled Clair; SCANNER=trivy
# alone runs Trivy inside the web container, COMPOSE_PROFILES=trivy adds a shared
# Trivy server (then TRIVY_SERVER_URL=http://trivy:4954). Empty all to disable.
COMPOSE_PROFILES=clair
CLAIR_URL=http://clair:6060
SCANNER=
TRIVY_SERVER_URL=
# Scan workers (scan-worker) on other machines take Trivy scans off
# this host. SCAN_WORKER_TOKEN is what they authenticate with
# (scripts/deploy.sh generates one); SCAN_WORKERS=true queues scans for them.
SCAN_WORKER_TOKEN=
SCAN_WORKERS=false

# Email (empty SMTP_HOST logs mail to the web container's output)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional sign-in providers, group bindings, sign-up controls, token policy,
# branding, pull rate limits and STORAGE_STAGING=shared (several registryd
# replicas): see .env.example / README
# Prometheus endpoint: enable it under Administration → Metrics (or METRICS_ENABLED=true + METRICS_TOKEN)
