# Production (docker-compose.prod.yml). scripts/deploy.sh writes this file on
# the server with fresh secrets; edit values there afterwards if needed.
DOMAIN=oci.example.com
ACME_EMAIL=you@example.com
# Uncomment while testing to avoid Let's Encrypt production rate limits:
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_PASSWORD=change-me
AUTH_SECRET=change-me
WEBHOOK_SECRET=change-me
JOBS_API_TOKEN=

# Image layers: a directory on a big disk (e.g. a mounted share); unset = docker volume.
#REGISTRY_DATA_DIR=/mnt/unraid/chicoree/registry

# Vulnerability scanning: "clair" runs the bundled Clair; empty both to disable.
COMPOSE_PROFILES=clair
CLAIR_URL=http://clair:6060

# Email (empty SMTP_HOST logs mail to the web container's output)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional sign-in providers and group bindings: see .env.example / README
# Prometheus endpoint: enable it under Administration → Metrics (or METRICS_ENABLED=true + METRICS_TOKEN)
