# Copy to .env (scripts/gen-keys.sh does this and fills in the secrets).

# --- Core secrets ---
AUTH_SECRET=change-me
WEBHOOK_SECRET=change-me
# Bearer token for automation calling the jobs API (POST /api/jobs/<job>).
# Leave empty to only allow administrators' access tokens.
JOBS_API_TOKEN=change-me
# Set to false to disable the in-app job scheduler (Administration → Jobs →
# Schedule) on installs that trigger jobs from external cron instead.
JOB_SCHEDULER=true

# --- Public addresses ---
# What users type into the browser and docker CLI.
APP_URL=http://localhost:3000
REGISTRY_HOST=localhost:5000
# Host port the registry is published on (macOS: AirPlay squats on 5000 —
# use 5010 and set REGISTRY_HOST to match).
REGISTRY_PORT=5000

# --- Storage plugin: filesystem (default), s3, or bunny ---
STORAGE_DRIVER=filesystem
# Where in-flight uploads wait for their digest check: local (files on the
# registryd node — one replica, or sticky routing on /blobs/uploads/) or
# shared (sessions in Postgres, chunks in the storage backend — required for
# several registryd replicas behind one load balancer).
STORAGE_STAGING=local
# For s3, start compose with the minio profile or point at real S3:
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=registry
S3_ACCESS_KEY=chicoree
S3_SECRET_KEY=chicoree-minio
S3_FORCE_PATH_STYLE=true
# Serve blob downloads via presigned URLs straight from S3 (real S3 only —
# clients must be able to reach the endpoint):
S3_REDIRECT_GET=false

# For bunny (bunny.net Edge Storage). REGION: empty = Falkenstein, or
# ny, la, sg, se, br, jh, syd, uk. CDN_URL + CDN_TOKEN_KEY enable signed
# pull-zone redirects for blob downloads (token authentication must be on).
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=
BUNNY_REGION=
BUNNY_CDN_URL=
BUNNY_CDN_TOKEN_KEY=

# --- Vulnerability scanning ---
# Backend: off | clair | trivy (empty = clair when CLAIR_URL is set, else off).
# Administration → Scanning overrides this; changes apply to new scans.
SCANNER=
# Clair: downloads several GB of advisory data and needs Postgres. Start it
# with COMPOSE_PROFILES=clair. To run without scanning: COMPOSE_PROFILES= and
# CLAIR_URL= (both empty) — vulnerability columns, tabs and the scan job
# disappear from the UI.
COMPOSE_PROFILES=clair
CLAIR_URL=http://clair:6060
# Trivy: the web image ships the trivy binary (SCANNER=trivy needs nothing
# else; the database downloads into the trivy-cache volume on the first scan).
# COMPOSE_PROFILES=trivy adds a Trivy server that keeps the database for every
# web replica: then set TRIVY_SERVER_URL=http://trivy:4954. Empty = standalone.
# Scan workers (scan-worker, on other machines) take Trivy scans off
# this host: the token they present, and whether scans wait for them.
SCAN_WORKER_TOKEN=
SCAN_WORKERS=false
TRIVY_SERVER_URL=
# Token the Trivy server requires (`trivy server --token`); shared by every client.
TRIVY_SERVER_TOKEN=
TRIVY_TIMEOUT_SECONDS=600

# --- Keyless (Sigstore) signature verification ---
# Trusted root for Fulcio / Rekor / CT log keys. Empty = the bundled public
# Sigstore root (sigstore/root-signing); set a path to a trusted_root.json
# for a private Sigstore instance or a newer snapshot.
SIGSTORE_TRUSTED_ROOT=

# --- Email: defaults only (bundled Mailpit; inbox at http://localhost:8025), edit under Administration → Settings ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chicorée <registry@localhost>

# --- Optional OAuth sign-in: defaults only, edit under Administration → Settings ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any OIDC-compliant IdP (Keycloak, Authentik, Entra ID, ...)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
# Add "groups" (Keycloak/Authentik) if you bind roles to OIDC groups.
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups

# --- Optional LDAP / Active Directory: defaults only, edit under Administration → Settings ---
# Users sign in with their directory username + password (browser and
# `docker login`); accounts are created on first login.
LDAP_URL=
LDAP_NAME=LDAP
# Service account for looking users up (leave empty for anonymous search).
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
# {{username}} is replaced (escaped) with what the user typed. Active
# Directory: (&(objectClass=user)(sAMAccountName={{username}}))
LDAP_USER_FILTER=(&(objectClass=person)(uid={{username}}))
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_NAME=cn
# Multi-valued attribute on the user entry that lists group DNs.
LDAP_ATTR_GROUPS=memberOf
# Directories without memberOf: search groups instead ({{dn}} / {{username}}).
LDAP_GROUP_BASE=
LDAP_GROUP_FILTER=(|(member={{dn}})(uniqueMember={{dn}})(memberUid={{username}}))
# Entries without an email attribute get <username>@<this domain>.
LDAP_EMAIL_DOMAIN=
LDAP_START_TLS=false
LDAP_TLS_INSECURE=false
LDAP_TLS_CA_FILE=

# --- Group -> role bindings (LDAP, GitHub, Google, OIDC) ---
# ";"-separated "<group> => <target>" entries, re-applied on every sign-in
# through that provider. Targets: "admin" (instance administrator) or
# "<org-slug>:<owner|admin|member|viewer>". Groups:
#   LDAP    full DN or just the CN            cn=admins,ou=groups,dc=example,dc=com  |  admins
#   GitHub  github:<org> / github:<org>/<team> github:acme  |  github:acme/platform
#   Google  google:<group email> / google:<domain>  google:devs@example.com  |  google:example.com
#   OIDC    oidc:<groups-claim value>         oidc:developers
# See README "Group-based roles".
AUTH_GROUP_BINDINGS=
# e.g. AUTH_GROUP_BINDINGS=cn=registry-admins,ou=groups,dc=example,dc=com => admin; github:acme/platform => acme:owner; developers => acme:member

# --- Prometheus (defaults; Administration → Metrics overrides them) ---
# METRICS_ENABLED=true serves /api/metrics; scrapes must send "Authorization: Bearer <METRICS_TOKEN>".
# registryd accepts the same METRICS_TOKEN on its own GET /metrics.
METRICS_ENABLED=false
METRICS_TOKEN=

# --- WebAuthn (must match how users reach APP_URL) ---
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Chicorée Registry

# --- Sign-up controls (defaults; Administration → Auth providers → Access overrides them) ---
# open (anyone), invite (only through an organization invitation), closed (no new accounts).
# The very first account on an empty instance is always allowed.
SIGNUP_MODE=open
# Email domains allowed to register (comma-separated; empty = any); also applies
# to first logins through GitHub, Google, OIDC and LDAP.
SIGNUP_ALLOWED_DOMAINS=
# everyone | admins — who may create organizations.
ORG_CREATION=everyone
# Access tokens and service accounts: longest lifetime in days (0 = unlimited)
# and whether an expiry date is mandatory. Administration → Auth providers →
# Access overrides both; existing credentials are never shortened.
TOKEN_MAX_LIFETIME_DAYS=0
TOKEN_REQUIRE_EXPIRY=false
# Local sign-in (password, magic link, email code): everyone | hidden | off.
# hidden keeps it working only on /sign-in/<LOCAL_SIGNIN_PATH> for a break-glass
# administrator while everyone else uses SSO, LDAP or passkeys.
LOCAL_SIGNIN=everyone
LOCAL_SIGNIN_PATH=local

# --- Default limits (defaults; Administration → Limits overrides them) ---
# Given to every new account (summed across the organizations it owns) and to
# every new organization when created. Empty = unlimited; storage in GiB;
# administrators are exempt. Existing accounts keep their own limits.
DEFAULT_USER_MAX_ORGANIZATIONS=
DEFAULT_USER_MAX_PUBLIC_REPOS=
DEFAULT_USER_MAX_PRIVATE_REPOS=
DEFAULT_USER_MAX_STORAGE_GIB=
DEFAULT_ORG_MAX_PUBLIC_REPOS=
DEFAULT_ORG_MAX_PRIVATE_REPOS=
DEFAULT_ORG_MAX_STORAGE_GIB=
DEFAULT_ORG_MAX_MEMBERS=
# External account portal (billing, directory): with a URL set, account and
# organization settings show a Manage button that opens it with a one-time
# sign-in token (see README "Account portal"). Empty = no button.
PORTAL_URL=
PORTAL_LABEL=

# --- Branding (defaults; Administration → Branding overrides them) ---
INSTANCE_NAME=Chicorée
# Fall back to gravatar.com for accounts with no uploaded avatar (see README).
GRAVATAR=false
# Default for listing index members (variants, buildx attestation entries), attached
# artifacts and cosign tags next to images; users override it per account (see README).
SHOW_ARTIFACTS=false
INSTANCE_TAGLINE=Self-hosted OCI container registry
# self-hosted (default) or hosted: who the landing page speaks to. hosted turns
# "create the first account" into "create your account", names the free plan
# from the default limits and links to the account portal's plans. Nothing about
# the registry itself changes.
INSTANCE_EDITION=self-hosted

# --- Audit log ---
# Entries older than this are pruned (checked once an hour while entries are written).
AUDIT_RETENTION_DAYS=365

# --- Pull rate limits (defaults; Administration → Rate limits overrides them) ---
# "<count>/<window>" with the window in s, m, h or d (e.g. 100/6h); empty = unlimited.
# Manifest requests count as pulls, blob downloads do not. Read by the web app
# and registryd; anonymous limits are per client IP, authenticated per account.
RATE_LIMIT_ANONYMOUS=
RATE_LIMIT_AUTHENTICATED=
# Proxies (CIDRs or addresses, comma-separated) whose X-Forwarded-For registryd
# trusts for the client address; empty = the connecting peer is the client.
RATE_LIMIT_TRUSTED_PROXIES=

# --- Registry daemon ---
# Log format: text (default) or json.
REGISTRY_LOG_FORMAT=text
# Signing keys generated under Administration → Signing keys: how often
# registryd re-reads them and how long a retired key stays trusted (at least
# the 5-minute token lifetime). Defaults shown.
#TOKEN_KEY_RELOAD_INTERVAL=60s
#TOKEN_KEY_DROP_WINDOW=10m
# Base URL of the web app's internal API, where registryd reads proxy-cache
# configuration. Derived from WEBHOOK_URL (what compose sets), so only needed
# when the two are served from different places.
#INTERNAL_API_URL=http://web:3000/api/internal

# --- Monitoring overlay (docker-compose.observability.yml, profile "observability") ---
# Grafana login, Prometheus retention and the file holding the scrape token
# (write the token from Administration → Metrics into it).
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin
#PROMETHEUS_RETENTION=30d
#METRICS_TOKEN_FILE=./secrets/metrics-token
