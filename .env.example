# Copy to .env (scripts/gen-keys.sh does this and fills in the secrets).

# --- Core secrets ---
AUTH_SECRET=change-me
WEBHOOK_SECRET=change-me
# Bearer token for automation calling the jobs API (POST /api/jobs/<job>).
# Leave empty to only allow administrators' access tokens.
JOBS_API_TOKEN=change-me

# --- Public addresses ---
# What users type into the browser and docker CLI.
APP_URL=http://localhost:3000
REGISTRY_HOST=localhost:5000
# Host port the registry is published on (macOS: AirPlay squats on 5000 —
# use 5010 and set REGISTRY_HOST to match).
REGISTRY_PORT=5000

# --- Storage plugin: filesystem (default), s3, or bunny ---
STORAGE_DRIVER=filesystem
# For s3, start compose with the minio profile or point at real S3:
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=registry
S3_ACCESS_KEY=chicoree
S3_SECRET_KEY=chicoree-minio
S3_FORCE_PATH_STYLE=true
# Serve blob downloads via presigned URLs straight from S3 (real S3 only —
# clients must be able to reach the endpoint):
S3_REDIRECT_GET=false

# For bunny (bunny.net Edge Storage). REGION: empty = Falkenstein, or
# ny, la, sg, se, br, jh, syd, uk. CDN_URL + CDN_TOKEN_KEY enable signed
# pull-zone redirects for blob downloads (token authentication must be on).
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=
BUNNY_REGION=
BUNNY_CDN_URL=
BUNNY_CDN_TOKEN_KEY=

# --- Vulnerability scanning (Clair) ---
# Clair downloads several GB of advisory data and needs Postgres. To run
# without it: COMPOSE_PROFILES= and CLAIR_URL= (both empty) — vulnerability
# columns, tabs and the scan job disappear from the UI.
COMPOSE_PROFILES=clair
CLAIR_URL=http://clair:6060

# --- Email (defaults point at the bundled Mailpit; inbox at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chicorée <registry@localhost>

# --- Optional OAuth sign-in (set to enable the buttons) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any OIDC-compliant IdP (Keycloak, Authentik, Entra ID, ...)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
# Add "groups" (Keycloak/Authentik) if you bind roles to OIDC groups.
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups

# --- Optional LDAP / Active Directory sign-in (set LDAP_URL to enable) ---
# Users sign in with their directory username + password (browser and
# `docker login`); accounts are created on first login.
LDAP_URL=
LDAP_NAME=LDAP
# Service account for looking users up (leave empty for anonymous search).
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
# {{username}} is replaced (escaped) with what the user typed. Active
# Directory: (&(objectClass=user)(sAMAccountName={{username}}))
LDAP_USER_FILTER=(&(objectClass=person)(uid={{username}}))
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_NAME=cn
# Multi-valued attribute on the user entry that lists group DNs.
LDAP_ATTR_GROUPS=memberOf
# Directories without memberOf: search groups instead ({{dn}} / {{username}}).
LDAP_GROUP_BASE=
LDAP_GROUP_FILTER=(|(member={{dn}})(uniqueMember={{dn}})(memberUid={{username}}))
# Entries without an email attribute get <username>@<this domain>.
LDAP_EMAIL_DOMAIN=
LDAP_START_TLS=false
LDAP_TLS_INSECURE=false
LDAP_TLS_CA_FILE=

# --- Group -> role bindings (LDAP, GitHub, Google, OIDC) ---
# ";"-separated "<group> => <target>" entries, re-applied on every sign-in
# through that provider. Targets: "admin" (instance administrator) or
# "<org-slug>:<owner|admin|member|viewer>". Groups:
#   LDAP    full DN or just the CN            cn=admins,ou=groups,dc=example,dc=com  |  admins
#   GitHub  github:<org> / github:<org>/<team> github:acme  |  github:acme/platform
#   Google  google:<group email> / google:<domain>  google:devs@example.com  |  google:example.com
#   OIDC    oidc:<groups-claim value>         oidc:developers
# See README "Group-based roles".
AUTH_GROUP_BINDINGS=
# e.g. AUTH_GROUP_BINDINGS=cn=registry-admins,ou=groups,dc=example,dc=com => admin; github:acme/platform => acme:owner; developers => acme:member

# --- WebAuthn (must match how users reach APP_URL) ---
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Chicorée Registry
