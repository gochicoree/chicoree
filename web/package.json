{
  "name": "chicoree-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --format=esm --target=node22 --alias:@=./src --outfile=dist/worker.mjs --log-level=warning",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "lint": "tsc --noEmit && npm run api:check",
    "api:docs": "tsx scripts/api-docs.mts",
    "api:check": "tsx scripts/api-docs.mts --check",
    "api:smoke": "tsx scripts/api-smoke.mts"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@sigstore/bundle": "^4.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/verify": "^3.1.1",
    "@types/qrcode": "^1.5.6",
    "better-auth": "1.7.2",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.10",
    "ldapts": "^9.0.0",
    "lucide-react": "^0.545.0",
    "marked": "^18.0.11",
    "next": "16.3.4",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
